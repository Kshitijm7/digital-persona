  "modes": {
    "broadcast": {
      "description": "Polished, podcast-quality voice with full articulation",

      "lipsync": {
        "levelFloor": 0.02,
        "levelRange": 0.22,
        "levelExponent": 0.70,
        "activeVowelWeight": 0.58,
        "activeConsonantWeight": 0.50,
        "activeWeightBoost": 0.22,
        "silenceWeightMin": 0.08,
        "silenceWeightMax": 0.24,
        "silenceGainDamping": 0.65,
        "maxPendingVisemes": 72,
        "coarticulation": {
          "vowelCarryWeight": 0.24,
          "consonantCarryWeight": 0.18,
          "jawHeavyCarryLambda": 6,
          "vowelCarryLambda": 10,
          "fricativeCarryLambda": 14,
          "defaultCarryLambda": 18
        },
        "breathMicroMotion": {
          "enabled": true,
          "decayMs": 800,
          "frequencyHz": 2.5,
          "amplitude": 0.035
        },
        "volumeFallback": {
          "jawMult": 0.28,
          "mouthMult": 0.24,
          "jawCap": 0.45,
          "mouthCap": 0.40,
          "funnelRatio": 0.6,
          "puckerRatio": 0.4,
          "teethScale": 1.1
        }
      },

      "voicePresence": {
        "compressor": {
          "threshold": -24,
          "knee": 12,
          "ratio": 3,
          "attack": 0.003,
          "release": 0.15
        },
        "warmth": {
          "type": "lowshelf",
          "frequency": 200,
          "gain": 3
        },
        "presence": {
          "type": "highshelf",
          "frequency": 3500,
          "gain": 2
        }
      },

      "streamer": {
        "bufferSize": 2048,
        "maxQueueLength": 100,
        "initialBufferSec": 0.10,
        "lookAheadSec": 0.25,
        "recoveryOffsetSec": 0.03,
        "fadeSamples": 64,
        "stopRampSec": 0.015,
        "teardownDelayMs": 50
      },

      "emotion": {
        "speechLevelLambda": 8,
        "speechExpressionBoost": 0.25,
        "sentimentLambda": 2,
        "onsetLambda": 8,
        "releaseLambda": 3,
        "hoverSmile": 0.80,
        "hoverCheek": 0.30,
        "states": {
          "joy":       { "smile": 0.80, "cheek": 0.45, "browInnerUp": 0, "browDown": 0, "frown": 0 },
          "anger":     { "smile": 0, "cheek": 0, "browInnerUp": 0, "browDown": 0.75, "frown": 0.35 },
          "sadness":   { "smile": 0, "cheek": 0, "browInnerUp": 0.70, "browDown": 0, "frown": 0.60 },
          "surprised": { "smile": 0, "cheek": 0, "browInnerUp": 0.85, "browDown": 0, "frown": 0 },
          "fear":      { "smile": 0, "cheek": 0, "browInnerUp": 0.85, "browDown": 0, "frown": 0 },
          "disgust":   { "smile": 0, "cheek": 0, "browInnerUp": 0, "browDown": 0.50, "frown": 0.45 }
